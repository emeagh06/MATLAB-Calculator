                app.AnswerEditField.Value = current + "^2";
            end
        end

        % Button pushed function: Sqrt
        function ButtonSqrtPushed(app, event)
            expr = app.AnswerEditField.Value;
            try
                value = evalin('base', expr);

                if isnumeric(value) && isscalar(value)
                    result = sqrt(value);
                    app.AnswerEditField.Value = string(result);
                else 
                    app.AnswerEditField.Value = "Error";
                end
            catch
                app.AnswerEditField.Value = "Error";
            end
        end

        % Button pushed function: Enter
        function ButtonEnterPushed(app, event)
            expr = app.AnswerEditField.Value;  % get the text from the display
            try
                % Evaluate the expression 
                result = eval(expr);
                app.AnswerEditField.Value = string(result);
            catch
                % Show error if expression is invalid
                app.AnswerEditField.Value = "Error";
            end
        end

        % Close request function: UIFigure
        function ButtonLamp(app, event)

            expr = app.AnswerEditField.Value;
            try
                result = eval(expr);
                app.AnswerEditField.Value = string(result);
                app.Lamp.Color = [0 1 0];
            catch
                app.AnswerEditField.Value = "Error";
                app.Lamp.Color = [1 0 0];
            end
        end

        % Button pushed function: Clear
        function ButtonClearPushed(app, event)
            app.AnswerEditField.Value = "0";
            app.Lamp.Color = [0.5 0.5 0.5];
        end
    end

